# ============================================================
#  Performance Analysis of AI Models — Backend Environment
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (change this to a long random string in production)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_2024

# MongoDB connection string
# Local:   mongodb://localhost:27017/llmjudge
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/llmjudge
MONGODB_URI=mongodb://localhost:27017/llmjudge

# ── OpenRouter API (used for GPT-3.5, Claude Haiku, Llama 3) ──
# Sign up free at https://openrouter.ai and get your key
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Model IDs on OpenRouter ──
# These are the free / low-cost models — do NOT change unless you want different models
GPT_MODEL=openai/gpt-3.5-turbo
GEMINI_MODEL=google/gemini-2.5-flash
CLAUDE_MODEL=anthropic/claude-haiku
LLAMA_MODEL=meta-llama/llama-3-8b-instruct:free

# Optional: your site URL for OpenRouter referrer header
YOUR_SITE_URL=http://localhost:3000
YOUR_SITE_NAME=LLM-Judge

# Optional: keep these modest if your OpenRouter balance is low
OPENROUTER_MODEL_MAX_TOKENS=512
OPENROUTER_JUDGE_MAX_TOKENS=700

# Optional: local development only
AUTH_BYPASS=false
